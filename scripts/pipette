#!/bin/sh
# Colour picker: the colour of the clicked pixel, copied as #rrggbb and announced with a
# notification. Dependencies: grim, slurp, wl-clipboard, libnotify — and nothing else: the pixel is
# read from the PPM image of a single point, whose last three bytes are its red, green and blue.
set -eu
point="$(slurp -p -b 00000000 -c d4f4ffff)" || exit 0
couleur="$(grim -g "$point" -t ppm - | tail -c 3 | od -An -tu1 | awk '{ printf "#%02x%02x%02x", $1, $2, $3 }')"
printf '%s' "$couleur" | wl-copy
notify-send -a pipette "Couleur $couleur" "copiée dans le presse-papiers"
