#!/bin/sh
# Keyboard shortcut profile.
#
#   raccourcis            name of the active profile
#   raccourcis liste      available profiles
#   raccourcis <name>     switch and reload sway
#
# A profile is a file in sway/raccourcis/; the symlink ~/.config/sway/raccourcis-actif.conf names
# the active one, and the sway config includes that symlink. Switching profiles therefore never
# touches the repository, and the manual (super + F1) reads the same symlink: it stays correct on
# its own.
set -eu

config="${XDG_CONFIG_HOME:-$HOME/.config}"
profils="$config/supercalc/sway/raccourcis"
lien="$config/sway/raccourcis-actif.conf"

case "${1:-}" in
"")
	[ -L "$lien" ] && basename "$(readlink -f "$lien")" .conf || echo "aucun"
	;;
liste)
	for f in "$profils"/*.conf; do basename "$f" .conf; done
	;;
*)
	cible="$profils/$1.conf"
	[ -f "$cible" ] || { echo "profil inconnu : $1" >&2; echo "disponibles : $(cd "$profils" && ls *.conf | sed 's/\.conf//' | tr '\n' ' ')" >&2; exit 1; }
	ln -sfn "$cible" "$lien"
	# sway rereads its whole config: the old binds disappear along with the old profile
	[ -n "${SWAYSOCK:-}" ] && swaymsg reload >/dev/null || true
	echo "profil actif : $1"
	;;
esac
