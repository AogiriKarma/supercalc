# SUPERCALC — sway configuration (sway 1.12)
# No output is described here: every screen keeps its native resolution, its default position and
# its default scale, and the Quickshell bar adapts to whatever is plugged in.
# Screen placement, keyboard, touchpad: ~/.config/sway/config.d/*.conf (see the README).

set $supercalc ~/.config/supercalc
set $mod Mod4
set $term foot -c ~/.config/supercalc/foot/foot.ini
set $qs qs -c supercalc

include $supercalc/sway/theme.conf
# Active shortcut profile: a symlink to sway/raccourcis/<name>.conf, created by install.sh and
# moved by scripts/raccourcis. It allows switching without touching the repository, and the manual
# reads the same symlink so it stays correct.
include ~/.config/sway/raccourcis-actif.conf
include $supercalc/sway/regles.conf
include $supercalc/sway/demarrage.conf

# personal settings, never overwritten by a supercalc update
include ~/.config/sway/config.d/*
